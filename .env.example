# Copie para .env. NUNCA versionar credenciais ou certificados.
APP_ENV=dev
CLIENT_URL=http://localhost:5173
# Local (início rápido): sqlite:///./efi_dev.sqlite3
# Produção: postgresql+psycopg://usuario:senha@postgres:5432/efi
DATABASE_URL=sqlite:///./efi_dev.sqlite3

# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=
EFI_WEBHOOK_HASH=

# homologation | production (use homologation primeiro)
EFI_ENVIRONMENT=homologation
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
# Caminho local ABSOLUTO do .p12 do mesmo ambiente
EFI_CERTIFICATE_PATH=
EFI_CERTIFICATE_PASSWORD=

# Somente após publicar com HTTPS; sem barra final
PUBLIC_BASE_URL=

# Apenas para compose.yml com PostgreSQL local
POSTGRES_PASSWORD=
